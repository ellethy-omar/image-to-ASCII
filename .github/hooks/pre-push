#!/bin/sh

bash "$(dirname "$0")/doc-printing.sh"

echo "Running tests before push..."

npm run tests
STATUS=$?

COMMITTER_NAME=$(git config user.name)

if [ $STATUS -ne 0 ]; then
    cat "$(dirname "$0")/error-art.ans"
    printf "\n\x1b[31m AAAYYYYYOOOOOOOOOOOOOO!!!!!!!!! WHO LET BRO COOK!? \x1b[0m\n\n"
    printf "\n\x1b[31m Foolishness $COMMITTER_NAME, Foolishness. \x1b[0m\n\n"
    echo "Fix your tests! Get Strong, after that we can push your code."
    exit 1
fi

echo "Tests passed. Proceeding with push."
exit 0